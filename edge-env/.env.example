# ローカルビルド用: cp .env.example .env.dev → node --env-file=.env.dev build.mjs
# CI では各環境の CodeBuild の環境変数で渡す
EDGE_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
EDGE_MOBI_COGNITO_CLIENT_ID=
EDGE_PC_COGNITO_CLIENT_ID=
EDGE_AUTH0_DOMAIN=tenant.jp.auth0.com
EDGE_AUTH0_AUDIENCE=https://api.example.com
EDGE_KEYCLOAK_ISSUER=https://kc.example.com/realms/app
EDGE_CLI_API_KEYCLOAK_CLIENT_ID=
# 空なら CORS ヘッダーを付けない（カンマ区切り）
EDGE_CORS_ORIGINS=
